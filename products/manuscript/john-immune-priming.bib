	pmcid = {PMC7289658},
	pages = {1704--1714},
	file = {Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\SWNHKENV\\Cowling et al. - 2020 - Comparative Immunogenicity of Several Enhanced Inf.pdf:application/pdf;Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\89TVPULI\\Cowling et al. - 2020 - Comparative Immunogenicity of Several Enhanced Inf.pdf:application/pdf;PubMed Central Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\5GT79CU9\\Cowling et al. - 2020 - Comparative Immunogenicity of Several Enhanced Influenza Vaccine Options for Older Adults A Randomi.pdf:application/pdf;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\BK9FGND5\\5673516.html:text/html;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\GGE3NIU6\\5673516.html:text/html},
}

@article{zhong2024,
	title = {Influenza {A}({H3N2}) {Antibody} {Responses} to {Standard}-{Dose} {Versus} {Enhanced} {Influenza} {Vaccine} {Immunogenicity} in {Older} {Adults} and {Prior} {Season}'s {Vaccine} {Status}},
	volume = {229},
	issn = {0022-1899},
	url = {https://doi.org/10.1093/infdis/jiad497},
	doi = {10.1093/infdis/jiad497},
	abstract = {Annual influenza vaccination is recommended for older adults but repeated vaccination with standard-dose influenza vaccine has been linked to reduced immunogenicity and effectiveness, especially against A(H3N2) viruses.Community-dwelling Hong Kong adults aged 65–82 years were randomly allocated to receive 2017–2018 standard-dose quadrivalent, MF59-adjuvanted trivalent, high-dose trivalent, and recombinant-HA quadrivalent vaccination. Antibody response to unchanged A(H3N2) vaccine antigen was compared among participants with and without self-reported prior year (2016–2017) standard-dose vaccination.Mean fold rise (MFR) in antibody titers from day 0 to day 30 by hemagglutination inhibition and virus microneutralization assays were lower among 2017–2018 standard-dose and enhanced vaccine recipients with (range, 1.7–3.0) versus without (range, 4.3–14.3) prior 2016–2017 vaccination. MFR was significantly reduced by about one-half to four-fifths for previously vaccinated recipients of standard-dose and all 3 enhanced vaccines (β range, .21–.48). Among prior-year vaccinated older adults, enhanced vaccines induced higher 1.43 to 2.39-fold geometric mean titers and 1.28 to 1.74-fold MFR versus standard-dose vaccine by microneutralization assay.In the context of unchanged A(H3N2) vaccine strain, prior-year vaccination was associated with reduced antibody response among both standard-dose and enhanced influenza vaccine recipients. Enhanced vaccines improved antibody response among older adults with prior-year standard-dose vaccination.},
	number = {5},
	urldate = {2025-02-19},
	journal = {The Journal of Infectious Diseases},
	author = {Zhong, Shuyi and Ng, Tiffany W Y and Skowronski, Danuta M and Iuliano, A Danielle and Leung, Nancy H L and Perera, Ranawaka A P M and Ho, Faith and Fang, Vicky J and Tam, Yat Hung and Ip, Dennis K M and Havers, Fiona G and Fry, Alicia M and Aziz-Baumgartner, Eduardo and Barr, Ian G and Peiris, Malik and Thompson, Mark G and Cowling, Benjamin J},
	month = may,
	year = {2024},
	pages = {1451--1459},
	file = {Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\HCX78VLF\\Zhong et al. - 2024 - Influenza A(H3N2) Antibody Responses to Standard-Dose Versus Enhanced Influenza Vaccine Immunogenici.pdf:application/pdf;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\8NYCY7D6\\7405354.html:text/html;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\VELC3G86\\7405354.html:text/html},
