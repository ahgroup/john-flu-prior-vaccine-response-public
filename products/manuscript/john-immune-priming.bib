	month = feb,
	year = {2024},
	keywords = {Influenza vaccine, Composite score, Hemagglutination inhibition assay, multiyear cohort, Repeat vaccination},
	pages = {322--326},
	file = {Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\74K8ZTHT\\Sung et al. - 2023 - Assessment of Humoral Immune Responses to Repeated Influenza Vaccination in a Multiyear Cohort A 5-.pdf:application/pdf;Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\KK2DA878\\Sung et al. - 2024 - Assessment of Humoral Immune Responses to Repeated Influenza Vaccination in a Multiyear Cohort A 5-.pdf:application/pdf;Full Text PDF:C\:\\Users\\handelgroup\\Zotero\\storage\\QU4DEEIE\\Sung et al. - 2024 - Assessment of Humoral Immune Responses to Repeated Influenza Vaccination in a Multiyear Cohort A 5-.pdf:application/pdf;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\NAGETZMP\\7251228.html:text/html;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\WUM66Z87\\7251228.html:text/html},
