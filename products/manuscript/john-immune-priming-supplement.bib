
@article{moritzky2022,
	title = {The {Negative} {Effect} of {Preexisting} {Immunity} on {Influenza} {Vaccine} {Responses} {Transcends} the {Impact} of {Vaccine} {Formulation} {Type} and {Vaccination} {History}},
	volume = {227},
	issn = {0022-1899},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9891420/},
	doi = {10.1093/infdis/jiac068},
	abstract = {The most effective measure to induce protection from influenza is vaccination. Thus, yearly vaccination is recommended, which, together with infections, establishes diverse repertoires of B cells, antibodies, and T cells. We examined the impact of this accumulated immunity on human responses in adults to split, subunit, and recombinant protein-based influenza vaccines. Enzyme-linked immunosorbent assay (ELISA) assays, to quantify serum antibodies, and peptide-stimulated CD4 T-cell cytokine ELISpots revealed that preexisting levels of hemagglutinin (HA)-specific antibodies were negatively associated with gains in antibody postvaccination, while preexisting levels of CD4 T cells were negatively correlated with vaccine-induced expansion of CD4 T cells. These patterns were seen independently of the vaccine formulation administered and the subjects’ influenza vaccine history. Thus, although memory CD4 T cells and serum antibodies consist of components that can enhance vaccine responses, on balance, the accumulated immunity specific for influenza A H1 and H3 proteins is associated with diminished future responses., The impact of accumulated influenza-specific antibodies and CD4 T cells on human responses to influenza vaccines was examined. These studies revealed that, on balance, preexisting immunity specific for influenza A H1 and H3 proteins is associated with diminished future responses.},
	language = {en},
	number = {3},
	urldate = {2023-03-21},
	journal = {The Journal of Infectious Diseases},
	author = {Moritzky, Savannah A and Richards, Katherine A and Glover, Maryah A and Krammer, Florian and Chaves, Francisco A and Topham, David J and Branche, Angela and Nayak, Jennifer L and Sant, Andrea J},
	month = feb,
	year = {2022},
	keywords = {immune imprinting, influenza, original antigenic sin, Influenza virus, Vaccines, Adult, Computational biology and bioinformatics, Female, Humans, Male, Time Factors, Antibodies, immunology, Immunological, Models, Vaccination, antagonists \& inhibitors, Human, Influenza, Influenza A virus, Neuraminidase, Viral, Influenza, Human, Antibodies, Viral, Influenza Vaccines, Antiviral Agents, drug therapy, physiology, therapeutic use, virology, Influenza A Virus, H1N1 Subtype, Seasons, Influenza A Virus, H3N2 Subtype, Sentinel Surveillance, Vaccine effectiveness, Hemagglutinin Glycoproteins, Influenza Virus, vaccine, CD4 T cells, CD4-Positive T-Lymphocytes, Biological, effectiveness, efficacy, meta-analysis, Virus Replication, Immunogenicity, Vaccine, Immunization Schedule, Risk Assessment, Vaccines, Attenuated, *Computational Biology, *Models, Theoretical, antagonists /\&/ inhibitors, artificial intelligence, autoML, bioinformatics, broadly neutralizing antibody, Communicable Diseases/*epidemiology, computational biology, Computer Graphics, Computer Simulation, data mining, data science, Disease Outbreaks, Drug Resistance, drug therapy/epidemiology/immunology/transmission/virology, DSML 3: Development/Pre-production: Data science output has been rolled out/validated across multiple domains/problem, epidemiology, immunogenicity, Immunology, Inactivated vaccines, influenza A H3N2 virus, Live attenuated vaccines, machine learning, mapping antibody repertoires, methods, Observational Studies as Topic, prevention /\&/ control, prevention \& control, recurrent, repeat, repeated influenza exposures, Repeated vaccination, Research data, Research Design, Risk Factors, seasons (2015-2016, 2016-2017, 2017-2018, 2018-2019, 2019-2020), software, Software, systems biology, transmission, Treatment Outcome, User-Computer Interface, Vaccine Potency, Viral infection, vaccines, immune memory, human immunity},
	pages = {381--390},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\J6VJSFB2\\Moritzky et al. - 2023 - The Negative Effect of Preexisting Immunity on Inf.pdf:application/pdf;Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\BHIWW97R\\Moritzky et al. - 2022 - The negative effect of pre-existing immunity on in.pdf:application/pdf;Moritzky et al. - 2023 - The Negative Effect of Preexisting Immunity on Inf.pdf:C\:\\Users\\handelgroup\\Zotero\\storage\\9VWQQWCT\\Moritzky et al. - 2023 - The Negative Effect of Preexisting Immunity on Inf.pdf:application/pdf},
